{
  "name": "scheduling-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm -w @scheduling/web run dev",
    "dev:api": "npm -w @scheduling/api run dev",
    "seed": "npm -w @scheduling/api run seed",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
