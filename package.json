{
  "name": "scheduling-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm -w @scheduling/web run dev",
    "dev:api": "npm -w @scheduling/api run dev",
    "seed": "npm -w @scheduling/api run seed",
    "build": "npm run build --workspaces",
    "test": "npm -w @scheduling/api run test",
    "test:e2e": "npx playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.1.0"
  }
}
